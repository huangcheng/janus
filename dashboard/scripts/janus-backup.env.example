# Escrow this file (mode 600). Never commit. Install on leader as
# /opt/stacks/janus/janus-backup.env OR pass JANUS_BACKUP_ENV_FILE=.
#
# Age: ≥2 recipients required (public keys or recipient files).
JANUS_BACKUP_AGE_RECIPIENTS=age1xxxx...,age1yyyy...
# Identity for restore (escrow private; not needed for backup):
# AGE_IDENTITY_FILE=/root/.age/janus-backup.txt

# Alert on backup failure / staleness (optional webhook)
# JANUS_BACKUP_ALERT_URL=https://hooks.example/janus-backup

# Topology + node identity (H3-D7). The backup job refuses to dump when the
# topology names a different host as leader. On the leader node there is no
# operator-side topology FILE: point at the current leader explicitly.
# JANUS_TOPOLOGY_LEADER=nodea
# JANUS_TOPOLOGY_FILE=/opt/stacks/janus/topology
#
# This host's topology alias — the SSH alias the topology uses for it, not
# its OS hostname. Default: derived from the local hostname when that matches
# the topology leader or a JANUS_FOLLOWER_HOSTS entry; otherwise the job
# FAILS CLOSED with an instruction to set this. Set it explicitly on the
# leader (and leave it unset on followers, which must never run the timer).
# JANUS_BACKUP_NODE_ALIAS=nodea

# Cold store — pick ONE:
# A) Aliyun OSS (S3-compatible)
# JANUS_BACKUP_S3_ENDPOINT=https://oss.example.invalid
# JANUS_BACKUP_S3_BUCKET=janus-backups-other-account
# JANUS_BACKUP_S3_ACCESS_KEY_ID=
# JANUS_BACKUP_S3_SECRET_ACCESS_KEY=
# B) rclone remote path prefix
# JANUS_BACKUP_RCLONE_REMOTE=oss-cold:janus-backups
# C) Interim local cold dir (same-account coupling — not preferred)
# JANUS_BACKUP_COLD_DIR=/var/backups/janus-cold

# Defaults (override only if needed)
# JANUS_BACKUP_HOT_DIR=/var/backups/janus
# Cold-store pruning is NOT implemented in v1: nothing is deleted from the
# cold store; JANUS_BACKUP_COLD_PRUNE=1 only logs a warning. Prune manually.
# Staleness unit: 1 (default) = a stale/missing last_success fails the unit;
# 0 = alert-only opt-in (a failed alert POST still exits non-zero).
# JANUS_BACKUP_REQUIRED=1
# JANUS_BACKUP_HOT_RETENTION_DAYS=3

# Followers for restore floor + keyring sync (ssh host aliases)
# JANUS_FOLLOWER_HOSTS=worker-1,worker-2

# Stats token for generation floor probes (same as deploy)
# JANUS_STATS_TOKEN=
