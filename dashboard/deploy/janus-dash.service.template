# janus-dash.service.template — systemd unit for the BARE-METAL Janus
# dashboard (spec 2026-10-15-bare-metal-deploy B-D3/B-D7 dash half,
# Task 2). The dashboard is LEADER-ONLY (spec §4: Task 2 runs on the
# leader; F4b "it runs bare on the leader").
#
# scripts/install_bare_dashboard.sh substitutes the __*__ placeholders
# from the inventory (deploy/inventory.env contract, spec §0) and
# installs the result to /etc/systemd/system/janus-dash.service:
#
#   __JANUS_BARE_USER__   systemd User= (inventory JANUS_BARE_USER)
#   __JANUS_BARE_PREFIX__ bare tree root (inventory JANUS_BARE_PREFIX);
#                         the payload lives at $PREFIX/dash/<sha>/ with
#                         a `current` symlink (B-D3)
#   __DASH_PORT__         inventory JANUS_DASH_PORT — the uvicorn port
#                         caddy proxies today (port-free ExecStartPre
#                         probe, F1 layer 3 discipline: refuse to
#                         dual-bind against the compose dashboard)
#   __PG_PROBE__          Postgres-ready ExecStartPre line against
#                         JANUS_DB_ENDPOINT (F4b — same endpoint the
#                         generated EnvironmentFile rewrites the DB
#                         keys to; the DB container starts slower than
#                         network-online)
#
# Runtime shape mirrors the container CMD (Dockerfile) with two
# deliberate differences:
#   python -m uvicorn app.main:app --host 0.0.0.0 --port $JANUS_DASH_PORT
# 1. the bind stays 0.0.0.0 — 06f M1 is DEFERRED on purpose. On a bare
#    host 0.0.0.0 listens on every interface, so a client that can reach
#    __DASH_PORT__ bypasses Caddy's TLS and security headers. Loopback is
#    the hardening we want, but Caddy runs on the `caddy-net` bridge (the
#    compose dashboard is `networks: [caddy-net, db-net]`) and reaches a
#    host process through the host gateway, not host loopback. Flip this
#    to 127.0.0.1 only after verifying the Caddy upstream on the target
#    host (host networking / host-gateway / firewall); otherwise the
#    dashboard 502s. In the container 0.0.0.0 is namespaced and published
#    through the port mapping, so the Dockerfile stays as it is.
# 2. the python is the payload's OWN venv python (F7: venv per sha pins
#    the node's python3.<py3>) and WorkingDirectory is the payload root
#    so `app.main` resolves from the shipped tree — the same precedence
#    the image relies on (site-packages copy is never the runtime copy;
#    the venv install exists to carry the dependencies + the by-name own
#    wheel, F7).
#
# JANUS_DASH_BARE seam (Task 1 deviation 4): the janus repo's
# switch_runtime.sh disables the COMPOSE dashboard service via the
# JANUS-MANAGED profiles:["disabled"] override ONLY when the inventory
# carries JANUS_DASH_BARE=true. install_bare_dashboard.sh verifies
# that same key BEFORE installing/starting this unit — one flag owns
# both halves of the flip (no window where neither side is disabled).
#
# systemd notes: Type=exec means the unit is started only once the
# uvicorn process has actually exec'd (a crashed import surfaces as a
# failed start, not a silent flap — the app's boot-time schema
# self-check refusal included).

[Unit]
Description=Janus dashboard (bare uvicorn, leader)
Documentation=file://__JANUS_BARE_PREFIX__/dash/current/pyproject.toml
# F1 layer 3: keep compose infra (Postgres, caddy) ordered before the
# bare dashboard looks for them; network-online alone races the DB
# container start.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=__JANUS_BARE_USER__
# Payload root via the `current` symlink: `app.main` imports from the
# shipped tree (cwd precedes site-packages under `python -m`), and the
# app resolves spa/dist + docs/schemas from Path(__file__).parent.parent
# — i.e. this directory (same layout the container image ships).
WorkingDirectory=__JANUS_BARE_PREFIX__/dash/current
# Generated by install_bare_dashboard.sh from the node's compose
# DASHBOARD service definition (F2/F4b dash half) — root-owned,
# service-group-readable 0640, DB endpoint rewritten LAST shape-aware.
EnvironmentFile=__JANUS_BARE_PREFIX__/env/janus-dash.env

# Port-free probe (dual-bind guard): the compose dashboard service
# must be stopped (switch_runtime.sh override + docker stop) before
# the bare uvicorn binds; a busy port fails the start loudly instead
# of flapping between runtimes.
# 06b M1: NO space after the colon in the ss filter — iproute2 rejects
# `sport = : <port>` with a bison syntax error (exit 255, empty stdout),
# so the guard could never fire (same defect install_bare_dashboard.sh
# fixed in step 7). Keep it `sport = :__DASH_PORT__`.
ExecStartPre=/bin/sh -c 'if /usr/bin/ss -H -ltn "sport = :__DASH_PORT__" | grep -q .; then echo "janus-dash: port __DASH_PORT__ already listening (compose dashboard not stopped? see install_bare_dashboard.sh / switch_runtime.sh F1)"; exit 1; fi'
__PG_PROBE__

# 06f M1 DEFERRED (see the header): 0.0.0.0 keeps the `caddy-net` Caddy
# able to reach this host process through the host gateway. Do not flip
# this to 127.0.0.1 without verifying the Caddy upstream first — a
# mismatch makes the dashboard unreachable (502) after the flip.
ExecStart=__JANUS_BARE_PREFIX__/dash/current/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port __DASH_PORT__

Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
