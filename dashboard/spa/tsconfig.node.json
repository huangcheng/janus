// Typechecks the dev-server config (vite.config.ts), which the app tsconfig
// deliberately excludes. DOM lib: Node 18+ globals used here (fetch/URL) have
// the DOM signatures, and the repo has no @types/node (see
// vite-node-shims.d.ts for the two Node globals it does need).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "vite-node-shims.d.ts"]
}
