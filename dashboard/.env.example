# Database (same Postgres the gateways share)
JANUS_DB_HOST=localhost
JANUS_DB_PORT=5432
JANUS_DB_USER=janus
JANUS_DB_PASSWORD=
JANUS_DB_NAME=janus

# Dashboard auth
JANUS_DASHBOARD_PASSWORD=
JANUS_JWT_SECRET=
JANUS_SESSION_TTL_SEC=43200

# Cloudflare Turnstile (login). Leave TURNSTILE_SECRET empty to skip
# Siteverify (local / Vite auto-login). When set, require a fresh token
# and allowlist Siteverify hostnames (local: localhost,127.0.0.1;
# prod: your-gateway.example.com — never put localhost in prod).
# SPA build also needs VITE_TURNSTILE_SITEKEY=<public sitekey>.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# Crypto (must match the gateway)
JANUS_SECRETS_KEY=
JANUS_API_KEY_PEPPER=

# Server
JANUS_DASHBOARD_HOST=0.0.0.0
JANUS_DASHBOARD_PORT=8091

# Node management
JANUS_STATS_TOKEN=
JANUS_NODE_HEALTH_INTERVAL_SEC=10

# Model sync
JANUS_MODEL_SYNC_INTERVAL_SEC=21600

# Upstream TLS
JANUS_UPSTREAM_TLS_VERIFY=peer
