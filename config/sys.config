[
  {janus, [
    {http_port, 8080},
    {db, #{
        %% Auto: postgres if JANUS_DB_URL / JANUS_DB_HOST set, else sqlite.
        %% Override with {backend, postgres | sqlite}.
        backend => auto,
        sqlite_path => "data/janus.db"
    }}
  ]},
  {janus_admin, [
    %% Admin plane. In Docker the listener binds 0.0.0.0 (the container
    %% network is the isolation boundary); on bare metal keep 127.0.0.1
    %% or put Caddy (TLS + optional IP allowlist) in front.
    %% Override at runtime with JANUS_ADMIN_BIND / JANUS_ADMIN_PORT.
    {port, 8090},
    {bind, "0.0.0.0"},
    %% Set true when serving over HTTPS so the session cookie gets Secure.
    {secure_cookies, false}
    %% Login password comes from JANUS_ADMIN_PASSWORD (unset => logins
    %% disabled). Session TTL / lockout tuning:
    %% {ttl_sec, 43200}, {max_fails, 5}, {fail_window_sec, 900}, {lockout_sec, 900}
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
