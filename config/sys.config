[
  {janus, [
    {http_port, 8080},
    {db, #{
        %% Auto: postgres if JANUS_DB_URL / JANUS_DB_HOST set, else sqlite.
        %% Override with {backend, postgres | sqlite}.
        backend => auto,
        sqlite_path => "data/janus.db"
    }},
    %% janus-auto virtual model router (design/auto-router/SPEC.md).
    %% Tiers and judge are deployer-designated; leave tiers empty to disable.
    {auto_router, [
      {model, "janus-auto"},
      {judge_model, undefined},
      {tiers, #{fast => [], big => [], flagship => []}},
      {default_tier, fast}
      %% {big_ctx_tokens, 60000}, {fast_ctx_tokens, 8000},
      %% {max_ctx_tokens, undefined}, {judge_timeout_ms, 1500},
      %% {judge_max_inflight, 8}, {cache_ttl_sec, 300},
      %% {media_token_allowance, 4096}, {max_media_parts, 10},
      %% {markers, ["ultrathink", "think harder"]}
    ]}
  ]},
  {janus_dashboard, [
    %% Dashboard plane. In Docker the listener binds 0.0.0.0 (the container
    %% network is the isolation boundary); on bare metal keep 127.0.0.1
    %% or put Caddy (TLS + optional IP allowlist) in front.
    %% Override at runtime with JANUS_DASHBOARD_BIND / JANUS_DASHBOARD_PORT.
    {port, 8090},
    {bind, "0.0.0.0"},
    %% Set true when serving over HTTPS so the session cookie gets Secure.
    {secure_cookies, false}
    %% Login password comes from JANUS_DASHBOARD_PASSWORD (unset => logins
    %% disabled). Session TTL / lockout tuning:
    %% {ttl_sec, 43200}, {max_fails, 5}, {fail_window_sec, 900}, {lockout_sec, 900}
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
