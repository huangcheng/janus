[
  {janus, [
    {http_port, 8080},
    {db, #{
        %% Auto: postgres if JANUS_DB_URL / JANUS_DB_HOST set, else sqlite.
        %% Override with {backend, postgres | sqlite}.
        backend => auto,
        sqlite_path => "data/janus.db"
    }},
    %% Provider model-list sync: poll GET /models every N sec and upsert
    %% new names as disabled rows (dashboard one-click enable). 0 = manual only.
    %% {model_sync_interval_sec, 21600}, {model_sync_on_start, false},
    %% Admin stats plane polled by the standalone dashboard (read-only,
    %% token-authenticated via JANUS_STATS_TOKEN).
    %% {admin_port, 8090},
    %% janus-auto virtual model router (design/auto-router/SPEC.md).
    %% Tiers and judge are deployer-designated; leave tiers empty to disable.
    {auto_router, [
      {model, "janus-auto"},
      {judge_model, undefined},
      {tiers, #{fast => [], big => [], flagship => []}},
      {default_tier, fast}
      %% {big_ctx_tokens, 60000}, {fast_ctx_tokens, 8000},
      %% {max_ctx_tokens, undefined}, {judge_timeout_ms, 1500},
      %% {judge_max_inflight, 8}, {cache_ttl_sec, 300},
      %% {media_token_allowance, 4096}, {max_media_parts, 10},
      %% {markers, ["ultrathink", "think harder"]}
    ]}
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
