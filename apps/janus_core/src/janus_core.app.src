{application, janus_core, [
    {description, "Janus core: DB adapter, ETS config cache, LB"},
    {vsn, "0.1.0"},
    {registered, [janus_core_sup, janus_config, janus_lb]},
    {mod, {janus_core_app, []}},
    {applications, [
        kernel,
        stdlib,
        epgsql,
        esqlite,
        thoas,
        crypto
    ]},
    {env, []},
    {modules, []}
]}.
