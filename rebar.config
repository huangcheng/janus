{erl_opts, [debug_info]}.

{project_plugins, [erlfmt]}.
{erlfmt, [write]}.

{project_app_dirs, ["apps/*"]}.

{deps, [
    {cowboy, "2.12.0"},
    {cowlib, "2.13.0"},
    {ranch, "2.1.0"},
    {thoas, "1.2.1"},
    {gun, "2.1.0"},
    {epgsql, "4.7.1"},
    {esqlite, "0.8.1"}
]}.

{relx, [
    {release, {janus, "0.1.0"}, [
        janus,
        sasl,
        runtime_tools
    ]},
    {mode, prod},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},
    {extended_start_script, true},
    {include_erts, true}
]}.

{profiles, [
    {dev, [
        {relx, [
            {mode, dev},
            {include_erts, false},
            {dev_mode, true}
        ]}
    ]},
    {prod, [
        {relx, [{mode, prod}, {include_erts, true}]}
    ]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [janus]}
]}.
