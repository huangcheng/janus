{erl_opts, [debug_info]}.

{project_plugins, [erlfmt]}.
{erlfmt, [write]}.

{project_app_dirs, ["apps/*"]}.

{deps, [
    {cowboy, "2.12.0"},
    {cowlib, "2.13.0"},
    {ranch, "2.1.0"},
    {thoas, "1.2.1"},
    {gun, "2.1.0"},
    {epgsql, "4.7.1"},
    {esqlite, "0.8.1"}
]}.

{relx, [
    {release, {janus, "0.1.0"}, [
        janus,
        sasl,
        runtime_tools
    ]},
    {mode, prod},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},
    {extended_start_script, true},
    {include_erts, true},
    %% Bare-metal deploy (spec 2026-10-15-bare-metal-deploy F5c): the
    %% shared vm.args/TLS renderer + the bare bin/janus wrapper ship
    %% INSIDE the release tarball. scripts/build_bare_release.sh swaps
    %% bin/janus.wrap over bin/janus (real script -> bin/janus.real)
    %% at build time; the container image carries the same files
    %% inert (its docker-entrypoint.sh renders instead).
    {overlay, [
        {mkdir, "etc"},
        {copy, "scripts/lib/janus_vm_args.sh", "etc/janus_vm_args.sh"},
        {copy, "scripts/release/janus.wrap", "bin/janus.wrap"}
    ]}
]}.

{profiles, [
    {dev, [
        {relx, [
            {mode, dev},
            {include_erts, false},
            {dev_mode, true}
        ]}
    ]},
    {prod, [
        {relx, [{mode, prod}, {include_erts, true}]}
    ]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [janus]}
]}.
