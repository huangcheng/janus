# Prometheus + Tempo + Grafana for a Janus deployment.
#
# Binding strategy: inside the container each service listens on 0.0.0.0
# (a process bound to the container's own 127.0.0.1 is unreachable through
# a docker port mapping). On the HOST every published port is pinned to
# 127.0.0.1, so nothing is reachable from the internet; a reverse proxy
# owns :443 and is the only ingress.
services:
  prometheus:
    image: prom/prometheus:v3.1.0
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=30d
      - --web.listen-address=0.0.0.0:47318
      - --web.enable-lifecycle
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prom-data:/prometheus
    ports:
      - "127.0.0.1:47318:47318"
    networks: [obs]

  tempo:
    image: grafana/tempo:2.7.1
    restart: unless-stopped
    command: ["-config.file=/etc/tempo.yaml"]
    volumes:
      - ./tempo/tempo.yaml:/etc/tempo.yaml:ro
      - tempo-data:/var/tempo
    ports:
      - "127.0.0.1:43210:43210"
      - "127.0.0.1:49673:49673"
    networks: [obs]

  grafana:
    image: grafana/grafana:11.5.1
    restart: unless-stopped
    depends_on: [prometheus, tempo]
    environment:
      GF_SERVER_HTTP_ADDR: 0.0.0.0
      GF_SERVER_HTTP_PORT: "41127"
      GF_SECURITY_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD:?set in .env}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - graf-data:/var/lib/grafana
    ports:
      - "127.0.0.1:41127:41127"
    networks: [obs]

volumes:
  prom-data:
  tempo-data:
  graf-data:

networks:
  obs:
    driver: bridge
