# janus-gw.service.template — systemd unit for the BARE-METAL Janus
# gateway (spec 2026-10-15-bare-metal-deploy B-D2, locked decision).
#
# scripts/switch_runtime.sh substitutes the __*__ placeholders from
# deploy/inventory.env and installs the result to
# /etc/systemd/system/janus-gw.service on the node:
#
#   __JANUS_BARE_USER__   systemd User= (inventory JANUS_BARE_USER)
#   __JANUS_BARE_PREFIX__ bare tree root (inventory JANUS_BARE_PREFIX)
#   __GW_PORTS__          ports the gateway itself binds (space list;
#                         agent + admin + dist) — the ExecStartPre
#                         port-free probe (F1 layer 3)
#   __PG_PROBE__          leader: the Postgres-ready ExecStartPre line
#                         against JANUS_DB_ENDPOINT (F4b — the DB
#                         container starts slower than network-online);
#                         follower: /bin/true (no local DB dependency)
#   __EPMD_POST__         host-epmd wait, PLAIN epmd dist only (leader);
#                         /bin/true whenever dist TLS is on (worker,
#                         JANUS_FLEET_ENABLED, or a peer list) and for
#                         followers — those boot with -start_epmd false,
#                         so no host name is ever registered (06e H4)
#
# systemd notes: `$$` escapes a literal `$` for the shell under
# ExecStart/ExecStartPre; Type=exec means systemd considers the unit
# started only once the Erlang VM process has actually exec'd (a
# crashed boot surfaces as a failed start, not a silent flap).

[Unit]
Description=Janus gateway (bare release)
Documentation=file://__JANUS_BARE_PREFIX__/gw/current/README.md
# F1 layer 3: the DB (a container) may still be starting when the
# network is "online"; docker.service ordering keeps compose infra up
# before the bare gateway looks for it.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=__JANUS_BARE_USER__
# Generated by switch_runtime.sh from the node's compose service
# definition (F2) — root-owned, service-group-readable 0640.
EnvironmentFile=__JANUS_BARE_PREFIX__/env/janus-gw.env

# Port-free probe: the docker path must be fully stopped (F1 order)
# before the bare VM binds; a busy port fails the start loudly
# instead of flapping between runtimes.
ExecStartPre=/bin/sh -c 'for p in __GW_PORTS__; do if /usr/bin/ss -H -ltn "sport = :$$p" | grep -q .; then echo "janus-gw: port $$p already listening (docker side not stopped? see scripts/switch_runtime.sh F1)"; exit 1; fi; done'
__PG_PROBE__

ExecStart=__JANUS_BARE_PREFIX__/gw/current/bin/janus foreground

# F4c: with PLAIN epmd dist the bare BEAM registers with the HOST epmd;
# wait for it so a broken registration fails the start. TLS dist
# (-start_epmd false) never registers a host name: the switch emits
# /bin/true there (06e H4) and the F7b dist-join probe / exit assertions
# are the real check.
__EPMD_POST__

Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
