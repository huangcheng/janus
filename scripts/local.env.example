# Local Janus API (WSL OTP). Copy to data/local.env and fill secrets.
#   cp scripts/local.env.example data/local.env
JANUS_DASHBOARD_PASSWORD=dev
JANUS_API_KEY_PEPPER=local-dev-pepper
JANUS_SECRETS_KEY=k1:REPLACE_WITH_BASE64_32_BYTES
JANUS_SQLITE_PATH=/app/data/janus-local.db
JANUS_SEED_PATH=/app/data/seed.providers.json
JANUS_AUTO_SEED=1
JANUS_DASHBOARD_BIND=0.0.0.0
JANUS_MODEL_SYNC_INTERVAL_SEC=0
# all | gateway | dashboard  (gateway = no :8090, dashboard = no :8080)
JANUS_ROLE=all
# Public base URL agents use to reach the data plane when the gateway sits
# behind a reverse proxy (Caddy/Nginx + TLS). Shown in the console sidebar.
# Unset ⇒ the console assumes the data plane is on the same host, port 8080.
# JANUS_PUBLIC_URL=https://api.example.com
